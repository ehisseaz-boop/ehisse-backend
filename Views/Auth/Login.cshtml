@{
    ViewData["Title"] = "Daxil ol";
}

<div class="container" style="max-width: 500px; margin-top: 5rem; margin-bottom: 5rem;">
    <div style="background-color: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 2.5rem;">
        <div style="text-align:center; margin-bottom: 2rem;">
            <div class="logo-icon" style="width: 48px; height: 48px; font-size: 1.5rem; margin: 0 auto 1rem;">e</div>
            <h2 style="font-weight: 700; margin: 0;">Sistemə Giriş</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">Davam etmək üçün hesabınıza daxil olun</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background-color: rgba(255, 77, 77, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem;">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div style="margin-bottom: 1.5rem;">
                <label style="display:block; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">Nömrə və ya Email</label>
                <input type="text" name="username" value="@ViewBag.Username" required placeholder="050xxxxxxx və ya email"
                       style="width: 100%; padding: 0.75rem 1rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-main); outline: none; box-sizing:border-box;">
            </div>
            
            <div style="margin-bottom: 2rem;">
                <label style="display:block; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">Şifrə</label>
                <input type="password" name="password" required 
                       style="width: 100%; padding: 0.75rem 1rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-main); outline: none; box-sizing:border-box;">
            </div>
            
            <button type="submit" class="bg-accent" style="width: 100%; padding: 0.75rem; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: background-color 0.2s;">
                Daxil ol
            </button>
        </form>
        
        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
            Hesabınız yoxdur? <a href="/Auth/Register" class="text-accent" style="font-weight: 600;">Qeydiyyatdan keçin</a>
        </div>
    </div>
</div>


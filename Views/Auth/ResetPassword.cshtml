@{
    ViewData["Title"] = "Şifrəni Yenilə";
}

<div class="container" style="max-width: 500px; margin-top: 5rem; margin-bottom: 5rem;">
    <div style="background-color: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 16px; padding: 2.5rem;">
        <div style="text-align:center; margin-bottom: 2rem;">
            <div class="logo-icon" style="width: 48px; height: 48px; font-size: 1.5rem; margin: 0 auto 1rem;">e</div>
            <h2 style="font-weight: 700; margin: 0;">Şifrəni Yenilə</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">Yeni şifrənizi daxil edin.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background-color: rgba(255, 77, 77, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem;">
                @ViewBag.Error
            </div>
        }

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="username" value="@ViewBag.Username" />
            
            <div style="margin-bottom: 1.5rem;">
                <label style="display:block; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">İstifadəçi adı</label>
                <input type="text" value="@ViewBag.Username" disabled 
                       style="width: 100%; padding: 0.75rem 1rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-muted); outline: none; box-sizing:border-box;">
            </div>

            <div style="margin-bottom: 2rem;">
                <label style="display:block; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--text-muted);">Yeni Şifrə</label>
                <input type="password" name="newPassword" required 
                       style="width: 100%; padding: 0.75rem 1rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: white; outline: none; box-sizing:border-box;">
            </div>
            
            <button type="submit" class="bg-accent" style="width: 100%; padding: 0.75rem; border: none; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: background-color 0.2s;">
                Şifrəni Dəyiş
            </button>
        </form>
    </div>
</div>

@model EHisseler.Web.Models.SparePart

@{
    ViewData["Title"] = Model.Title;
    var mainImage = Model.Images?.FirstOrDefault(i => i.IsMain) ?? Model.Images?.FirstOrDefault();
    var otherImages = Model.Images?.Where(i => i.Id != mainImage?.Id).ToList();
    
    string? waRaw = Model.Seller.WhatsAppNumber ?? Model.Seller.Phone;
    string? telRaw = Model.Seller.Phone;
    
    bool canShowContact = Model.Seller.ShowContactInfoInAds && Model.Seller.IsPhoneVerified;
    string? waNum = "";
    string? telNum = "";
    bool hasValidWa = canShowContact && EHisseler.Web.Models.PhoneNumberHelper.TryNormalizeAzNumber(waRaw, out waNum, out _);
    bool hasValidTel = canShowContact && EHisseler.Web.Models.PhoneNumberHelper.TryNormalizeAzNumber(telRaw, out _, out telNum);
}

<div class="container my-5">
    <div class="mb-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left"></i> Geri qayıt</a>
    </div>

    <div class="row g-5">
        <!-- Sol Tərəf - Şəkillər -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                @if (mainImage != null)
                {
                    <img src="@Url.Action("GetImage", "Image", new { path = mainImage.ImageUrl })" class="img-fluid w-100" style="max-height: 500px; object-fit: contain; background: #fff;" alt="@Model.Title" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 400px;">
                        <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                    </div>
                }
            </div>
            
            @if (otherImages != null && otherImages.Any())
            {
                <div class="d-flex gap-2 overflow-auto hide-scrollbar">
                    @foreach (var img in otherImages)
                    {
                        <div class="rounded-3 border overflow-hidden" style="width: 80px; height: 80px; flex-shrink: 0;">
                            <img src="@Url.Action("GetImage", "Image", new { path = img.ImageUrl })" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Digər şəkil">
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sağ Tərəf - Məlumat və Satıcı -->
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-secondary bg-opacity-10 text-muted rounded-pill px-3 py-2 border border-secondary border-opacity-25">
                    @Model.DeviceModel.Brand.Name @Model.DeviceModel.Name
                </span>
                <div class="text-end">
                    @if (Model.CreatedDate.Date != DateTime.UtcNow.Date)
                    {
                        <span class="text-muted small me-3" title="Elanın qoyulma zamanı"><i class="bi bi-clock"></i> @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
                    }
                    <span class="text-muted small"><i class="bi bi-eye"></i> @Model.ViewCount baxış</span>
                </div>
            </div>
            
            <h1 class="fw-bold mb-3">@Model.Title</h1>
            
            <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                <h2 class="text-accent fw-bold mb-0">@Math.Floor(Model.Price) <small class="fs-5">@Model.Currency</small></h2>
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">
                    <i class="bi bi-check-circle-fill"></i> Stokda @Model.StockQuantity ədəd
                </span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="text-muted small mb-1">Kateqoriya</div>
                    <div class="fw-medium">@Model.DeviceModel.Category.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">Növ</div>
                    <div class="fw-medium">@Model.PartType.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">Keyfiyyət</div>
                    <div class="fw-medium">@Model.QualityType.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">Zəmanət</div>
                    <div class="fw-medium">@(Model.WarrantyMonths > 0 ? $"{Model.WarrantyMonths} ay" : "Yoxdur")</div>
                </div>
            </div>

            <h5 class="fw-bold mb-3">Məhsul haqqında</h5>
            <p class="text-muted mb-4" style="line-height: 1.6;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "M?hsul bar?d? ?lav? m?lumat qeyd edilm?yib." : Model.Description)
            </p>

            <!-- Satıcı Paneli -->
            <div class="card border-0 bg-light text-dark rounded-4 p-4 mt-5">
                <h5 class="fw-bold mb-4">Satıcı Məlumatları</h5>
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm me-3" style="width: 50px; height: 50px;">
                        <i class="bi bi-shop text-accent fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">@(Model.Seller.CompanyName ?? Model.Seller.ContactPerson)</h5>
                        <div class="text-muted small"><i class="bi bi-person"></i> @Model.Seller.ContactPerson</div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    @if (hasValidWa)
                    {
                        string adLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Home/Details/{Model.Id}";
                        string waMsg = $"Salam, bu ehtiyat hissəsi elanı ilə maraqlanıram: {Model.Title}. Elan kodu: {Model.Id}. Link: {adLink}";
                        <a href="https://wa.me/@waNum?text=@Uri.EscapeDataString(waMsg)" target="_blank" class="btn btn-success rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-whatsapp fs-5"></i> WhatsApp ilə yaz
                        </a>
                    }
                    @if (hasValidTel)
                    {
                        <a href="tel:@telNum" class="btn btn-primary rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2" style="background-color: var(--text-main); border-color: var(--text-main); color: var(--bg-main);">
                            <i class="bi bi-telephone-fill fs-5"></i> Zəng et
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Xəritə -->
    <div class="mt-5 pt-5 border-top">
        <h4 class="fw-bold mb-4"><i class="bi bi-geo-alt-fill text-danger"></i> Mağazanın ünvanı</h4>
        @if (!string.IsNullOrWhiteSpace(Model.Seller.Address))
        {
            <p class="mb-3">@Model.Seller.Address</p>
            <div class="rounded-4 overflow-hidden border shadow-sm">
                <iframe 
                    width="100%" 
                    height="400" 
                    frameborder="0" 
                    scrolling="no" 
                    marginheight="0" 
                    marginwidth="0" 
                    src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(Model.Seller.Address))&t=&z=15&ie=UTF8&iwloc=&output=embed">
                </iframe>
            </div>
        }
        else
        {
            <div class="alert alert-secondary border-0 rounded-4 text-center p-4">
                <i class="bi bi-info-circle fs-3 text-muted mb-2 d-block"></i>
                Satıcı dəqiq ünvan qeyd etməyib. Ətraflı məlumat üçün əlaqə saxlayın.
            </div>
        }
    </div>
</div>


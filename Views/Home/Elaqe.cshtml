@{
    ViewData["Title"] = "Əlaqə";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4 d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <h2 class="fw-bold mb-0">Bizimlə Əlaqə</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">Hər hansı bir sualınız və ya təklifiniz varsa, aşağıdakı formanı dolduraraq bizə müraciət edə bilərsiniz.</p>
                    
                    <form>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Adınız və Soyadınız</label>
                            <input type="text" class="form-control" placeholder="Məsələn: Əli Vəliyev" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">E-poçt ünvanınız</label>
                            <input type="email" class="form-control" placeholder="ad@nümunə.az" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-medium">Mövzu</label>
                            <input type="text" class="form-control" placeholder="Müraciətin mövzusu" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-medium">Mesajınız</label>
                            <textarea class="form-control" rows="5" placeholder="Mesajınızı buraya yazın..." required></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send me-2"></i> Göndər
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="row mt-5 text-center">
                <div class="col-md-4 mb-4">
                    <i class="bi bi-geo-alt fs-2 text-accent mb-2"></i>
                    <h5 class="fw-bold">Ünvan</h5>
                    <p class="text-muted">Bakı ş., Azərbaycan</p>
                </div>
                <div class="col-md-4 mb-4">
                    <i class="bi bi-telephone fs-2 text-accent mb-2"></i>
                    <h5 class="fw-bold">Telefon & WhatsApp</h5>
                    <p class="text-muted mb-1">
                        <a href="tel:+994102523226" class="text-decoration-none text-muted">+994 10 252 32 26</a>
                    </p>
                    <p class="text-muted mb-0">
                        <a href="https://wa.me/994103961501" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-whatsapp" style="color: #25D366;"></i> +994 10 396 15 01</a>
                    </p>
                </div>
                <div class="col-md-4 mb-4">
                    <i class="bi bi-envelope fs-2 text-accent mb-2"></i>
                    <h5 class="fw-bold">E-poçt</h5>
                    <p class="text-muted">info@e-hisse.az</p>
                </div>
            </div>
        </div>
    </div>
</div>


@model IEnumerable<EHisseler.Web.Models.SparePart>

@{
    ViewData["Title"] = "Vitrin";
    bool isSearch = !string.IsNullOrEmpty((string)ViewData["CurrentFilter"]) ||
                    ViewData["CurrentCategory"] != null ||
                    ViewData["CurrentBrand"] != null ||
                    ViewData["CurrentModel"] != null ||
                    ViewData["CurrentPartType"] != null ||
                    ViewData["CurrentQuality"] != null ||
                    ViewData["MinPrice"] != null ||
                    ViewData["MaxPrice"] != null ||
                    ViewData["CurrentSeller"] != null;
}

<div class="container">
    <section class="hero-section text-center" style="justify-content: center;">
        <div class="hero-content" style="width: 100%; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; align-items: center;">
            <div class="hero-subtitle" style="justify-content: center;">Ustalar və anbarlar üçün</div>
            <h1 class="hero-title">Doğru hissəni<br><span class="text-accent">tez tap.</span></h1>
            <p class="hero-desc">Telefon, planşet və noutbuk ehtiyat hissələri.<br>Yoxlanılmış satıcılardan, real stokla.</p>
            
            <form action="/" method="get" class="w-100" style="max-width: 900px;">
                <div class="search-box mb-2 d-flex align-items-center" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 50px; padding: 0.5rem 1rem;">
                    <i class="bi bi-search text-muted me-2 flex-shrink-0"></i>
                    <input type="text" name="searchString" id="heroSearchInput" placeholder="Telefon,Tablet ve s.." value="@ViewData["CurrentFilter"]" style="flex:1; background: transparent; border: none; color: var(--text-main); outline: none; min-width: 0; text-overflow: ellipsis;">
                    
                    <button type="button" class="btn p-0 position-relative ms-2 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#detailedSearchModal" style="border:none; outline:none;" id="btnOpenDetailedSearch">
                        <i class="bi bi-sliders text-accent" style="font-size: 1.2rem;"></i>
                        <span id="detailedFilterBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 0.6rem;">0</span>
                    </button>
                    
                    <button type="submit" class="btn btn-sm btn-primary bg-accent text-dark fw-bold px-3 ms-2 ms-md-3 rounded-pill flex-shrink-0">Axtar</button>
                </div>
                
                <!-- Modal for Detailed Search -->
                <div class="modal fade" id="detailedSearchModal" tabindex="-1" aria-labelledby="detailedSearchModalLabel" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content bg-surface text-start border-color">
                      <div class="modal-header border-color">
                        <h5 class="modal-title" id="detailedSearchModalLabel"><i class="bi bi-sliders text-accent me-2"></i> Detallı axtarış</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Bağla"></button>
                      </div>
                      <div class="modal-body" id="detailedSearchBody">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Kateqoriya</label>
                                <select name="categoryId" id="hero-categoryId" class="form-select form-select-sm bg-custom text-main border-custom filter-input">
                                    <option value="">Bütün kateqoriyalar</option>
                                    @if (ViewBag.Categories != null)
                                    {
                                        foreach (var cat in (IEnumerable<EHisseler.Web.Models.Category>)ViewBag.Categories)
                                        {
                                            if (ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())
                                            {
                                                <option value="@cat.Id" selected>@cat.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Brend</label>
                                <select name="brandId" id="hero-brandId" class="form-select form-select-sm bg-custom text-main border-custom filter-input">
                                    <option value="">Bütün brendlər</option>
                                    @if (ViewBag.Brands != null)
                                    {
                                        foreach (var brand in (IEnumerable<EHisseler.Web.Models.DeviceBrand>)ViewBag.Brands)
                                        {
                                            if (ViewData["CurrentBrand"]?.ToString() == brand.Id.ToString())
                                            {
                                                <option value="@brand.Id" selected>@brand.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@brand.Id">@brand.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Vəziyyəti</label>
                                <select name="qualityTypeId" class="form-select form-select-sm bg-custom text-main border-custom filter-input">
                                    <option value="">İstənilən vəziyyət</option>
                                    @if (ViewBag.QualityTypes != null)
                                    {
                                        foreach (var qt in (IEnumerable<EHisseler.Web.Models.QualityType>)ViewBag.QualityTypes)
                                        {
                                            if (ViewData["CurrentQuality"]?.ToString() == qt.Id.ToString())
                                            {
                                                <option value="@qt.Id" selected>@qt.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@qt.Id">@qt.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Qiymət aralığı (AZN)</label>
                                <div class="d-flex gap-2">
                                    <input type="number" name="minPrice" class="form-control form-control-sm bg-custom text-main border-custom filter-input" placeholder="Min" value="@ViewData["MinPrice"]" />
                                    <input type="number" name="maxPrice" class="form-control form-control-sm bg-custom text-main border-custom filter-input" placeholder="Max" value="@ViewData["MaxPrice"]" />
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input bg-accent border-accent filter-input" type="checkbox" name="inStockOnly" id="inStockOnlyHero" value="true" @(Convert.ToBoolean(ViewData["InStockOnly"] ?? false) ? "checked" : "")>
                                    <label class="form-check-label small" for="inStockOnlyHero">Yalnız stokda olanlar</label>
                                </div>
                            </div>
                        </div>
                      </div>
                      <div class="modal-footer border-color">
                        <button type="button" class="btn btn-outline-secondary me-auto" id="btnResetFilters">Sıfırla</button>
                        <button type="submit" class="btn btn-primary bg-accent text-dark fw-bold">Axtar</button>
                      </div>
                    </div>
                  </div>
                </div>
            </form>
            
            <div class="hero-stats justify-content-center w-100 mt-3">
                <span>@ViewBag.TotalParts</span> aktiv hissə
                <span class="dot">•</span>
                <span>@ViewBag.TotalSellers</span> təsdiqli satıcı
                <span class="dot">•</span>
                <span>Bu gün</span> yenilənib
            </div>
        </div>

    </section>

    @if (!isSearch)
    {
        <section>
            <div class="section-header">
                <div>
                    <div class="section-label">Kateqoriya</div>
                    <h2 class="section-title">Avadanlığını seç</h2>
                </div>
                <a href="/Home/Categories" class="link-accent">Hamısına bax <i class="bi bi-arrow-right"></i></a>
            </div>
            
            <div class="category-grid">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ((IEnumerable<EHisseler.Web.Models.Category>)ViewBag.Categories).OrderBy(c => c.DisplayOrder).Where(c => c.IsActive).Take(4))
                    {
                        if (!cat.IsActive) continue;
                        
                        var isActiveCat = ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString();
                        
                        var countsDict = ViewBag.CategoryCounts as Dictionary<int, int>;
                        int count = countsDict != null && countsDict.ContainsKey(cat.Id) ? countsDict[cat.Id] : 0;
                        
                        string icon = "bi-box";
                        string iconStyle = "color:#fff; background:rgba(255,255,255,0.05);";
                        
                        if (cat.Name.Contains("Telefon", StringComparison.OrdinalIgnoreCase))
                        {
                            icon = "bi-phone";
                            if (isActiveCat || cat.Id == 1) iconStyle = "color:var(--accent);";
                        }
                        else if (cat.Name.Contains("Planşet", StringComparison.OrdinalIgnoreCase)) icon = "bi-tablet";
                        else if (cat.Name.Contains("Noutbuk", StringComparison.OrdinalIgnoreCase)) icon = "bi-laptop";
                        else if (cat.Name.Contains("Smart Saat", StringComparison.OrdinalIgnoreCase)) icon = "bi-smartwatch";
                        else if (cat.Name.Contains("Qulaqlıq", StringComparison.OrdinalIgnoreCase) || cat.Name.Contains("Aksesuar", StringComparison.OrdinalIgnoreCase)) icon = "bi-earbuds";
                        else if (cat.Name.Contains("Kompüter", StringComparison.OrdinalIgnoreCase) || cat.Name.Contains("PC", StringComparison.OrdinalIgnoreCase)) icon = "bi-pc-display";
                        else if (cat.Name.Contains("Televizor", StringComparison.OrdinalIgnoreCase)) icon = "bi-tv";
                        else if (cat.Name.Contains("Konsol", StringComparison.OrdinalIgnoreCase)) icon = "bi-controller";
                        else if (cat.Name.Contains("Kamera", StringComparison.OrdinalIgnoreCase)) icon = "bi-camera";
                        else if (cat.Name.Contains("Alətlər", StringComparison.OrdinalIgnoreCase) || cat.Name.Contains("Təmir", StringComparison.OrdinalIgnoreCase)) icon = "bi-tools";
                        else if (cat.Name.Contains("Dron", StringComparison.OrdinalIgnoreCase)) icon = "bi-airplane";
                        else if (cat.Name.Contains("Samokat", StringComparison.OrdinalIgnoreCase)) icon = "bi-scooter";
                        else if (cat.Name.Contains("Şəbəkə", StringComparison.OrdinalIgnoreCase)) icon = "bi-router";
                        else if (cat.Name.Contains("Adapter", StringComparison.OrdinalIgnoreCase) || cat.Name.Contains("Kabel", StringComparison.OrdinalIgnoreCase)) icon = "bi-plug";

                        <a href="/?categoryId=@cat.Id" class="category-card @(isActiveCat ? "active" : "")">
                            <div class="category-icon" style="@iconStyle"><i class="bi @icon"></i></div>
                            <div class="category-info">
                                <h3>@cat.Name.Replace(" ehtiyat hissələri", "")</h3>
                                <p>@count hissə</p>
                            </div>
                            <i class="bi bi-arrow-up-right" style="position:absolute; top:1.5rem; right:1.5rem; color:var(--text-muted);"></i>
                        </a>
                    }
                }
            </div>
        </section>
    }

    <section>
        <div class="section-header" style="align-items:center;">
            <div>
                <div class="section-label">@(isSearch ? "Axtarış Nəticələri" : "Anbarda olanlar")</div>
                <h2 class="section-title">@(isSearch ? "Tapılan hissələr" : "Populyar hissələr")</h2>
            </div>
            <div style="display:flex; gap:0.5rem;">
                <button class="btn-outline" style="padding:0.5rem; border-color:var(--text-muted);"><i class="bi bi-grid-fill text-accent"></i></button>
                <button class="btn-outline" style="padding:0.5rem;"><i class="bi bi-list"></i></button>
            </div>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="d-flex gap-2 overflow-auto hide-scrollbar pb-1 w-100">
                <button class="btn-outline" style="border-radius:20px; font-size:0.85rem;" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas"><i class="bi bi-sliders"></i> Filtrlər</button>
                
                <a href="/?categoryId=@ViewData["CurrentCategory"]" class="btn-outline @(ViewData["CurrentPartType"] == null ? "bg-accent" : "") text-main text-decoration-none" style="border-radius:20px; font-size:0.85rem; @(ViewData["CurrentPartType"] == null ? "border:none; padding:0.5rem 1.5rem; color:#000!important;" : "")">Hamisi</a>
                
                <a href="/?categoryId=@ViewData["CurrentCategory"]&partTypeId=1" class="btn-outline @(ViewData["CurrentPartType"]?.ToString() == "1" ? "bg-accent" : "") text-main text-decoration-none" style="border-radius:20px; font-size:0.85rem; @(ViewData["CurrentPartType"]?.ToString() == "1" ? "border:none; color:#000!important;" : "")">Ekran</a>
                
                <a href="/?categoryId=@ViewData["CurrentCategory"]&partTypeId=2" class="btn-outline @(ViewData["CurrentPartType"]?.ToString() == "2" ? "bg-accent" : "") text-main text-decoration-none" style="border-radius:20px; font-size:0.85rem; @(ViewData["CurrentPartType"]?.ToString() == "2" ? "border:none; color:#000!important;" : "")">Batareya</a>
                
                <a href="/?categoryId=@ViewData["CurrentCategory"]&partTypeId=3" class="btn-outline @(ViewData["CurrentPartType"]?.ToString() == "3" ? "bg-accent" : "") text-main text-decoration-none" style="border-radius:20px; font-size:0.85rem; @(ViewData["CurrentPartType"]?.ToString() == "3" ? "border:none; color:#000!important;" : "")">Kamera</a>
                
                <a href="/?categoryId=@ViewData["CurrentCategory"]&partTypeId=5" class="btn-outline @(ViewData["CurrentPartType"]?.ToString() == "5" ? "bg-accent" : "") text-main text-decoration-none" style="border-radius:20px; font-size:0.85rem; @(ViewData["CurrentPartType"]?.ToString() == "5" ? "border:none; color:#000!important;" : "")">Ana plata</a>
            </div>
            <div id="sort-dropdown-container" style="font-size:0.85rem; color:var(--text-muted); display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                Sırala: <strong style="color:var(--text-main);">Ən çox baxılan</strong> <i class="bi bi-chevron-down"></i>
            </div>
        </div>

                @if (Model != null && Model.Any())
        {
            <div class="products-grid">

            @foreach (var part in Model)
            {
                var mainImage = part.Images?.FirstOrDefault(i => i.IsMain) ?? part.Images?.FirstOrDefault();
                <div class="product-card">
                    <div class="product-card-top">
                        <div>
                            @if(part.CreatedDate.Date == DateTime.UtcNow.Date) { <span class="badge-accent" style="margin-bottom:0.5rem;">Yeni</span> }
                            else if(part.ViewCount > 50) { <span class="badge-accent" style="margin-bottom:0.5rem;">Tövsiyə</span> }
                        </div>
                        <button class="btn-fav add-to-fav" data-id="@part.Id"><i class="bi bi-heart"></i></button>
                    </div>
                    
                    <a href="/Home/Details/@part.Id" class="product-image text-decoration-none">
                        @if (mainImage != null)
                        {
                            <img src="@Url.Action("GetImage", "Image", new { path = mainImage.ImageUrl })" alt="@part.Title" />
                        }
                        else
                        {
                            <!-- Fallback geometric glowing shapes based on product title or type -->
                            <div style="width: 80px; height: 80px; border: 4px solid var(--accent); border-radius: 50%; box-shadow: 0 0 20px var(--accent); opacity: 0.8;"></div>
                        }
                    </a>
                    
                    <div class="product-meta">
                        <span class="product-category">@(part.PartType?.Name ?? "DIG?R")</span>
                        <span class="product-stock">Stokda @part.StockQuantity ədəd</span>
                    </div>
                    
                    <a href="/Home/Details/@part.Id" class="text-decoration-none text-main"><h3 class="product-title">@part.DeviceModel?.Brand?.Name @part.DeviceModel?.Name @part.Title</h3></a>
                    <p class="product-desc">@part.DeviceModel?.Name - @part.QualityType?.Name</p>
                    
                    <div class="product-condition">
                        @part.QualityType?.Name
                    </div>
                    
                    <div class="product-bottom">
                        <div>
                            <div class="product-price">@Math.Floor(part.Price) <span>AZN</span></div>
                            <div class="product-seller">
                                <i class="bi bi-shop"></i> @(part.Seller?.CompanyName ?? part.Seller?.ContactPerson)
                            </div>
                        </div>
                        <a href="/Home/Details/@part.Id" class="btn-cart text-decoration-none"><i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            }
        </div>

        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5 mb-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm gap-2">
                        @{
                            var dict = new Dictionary<string, string>
                            {
                                { "searchString", ViewData["CurrentFilter"]?.ToString() },
                                { "categoryId", ViewData["CurrentCategory"]?.ToString() },
                                { "brandId", ViewData["CurrentBrand"]?.ToString() },
                                { "modelId", ViewData["CurrentModel"]?.ToString() },
                                { "partTypeId", ViewData["CurrentPartType"]?.ToString() },
                                { "qualityTypeId", ViewData["CurrentQuality"]?.ToString() },
                                { "minPrice", ViewData["MinPrice"]?.ToString() },
                                { "maxPrice", ViewData["MaxPrice"]?.ToString() },
                                { "sellerId", ViewData["CurrentSeller"]?.ToString() },
                                { "inStockOnly", ViewData["InStockOnly"]?.ToString() },
                                { "sortOrder", ViewData["CurrentSort"]?.ToString() }
                            };
                            
                            var routeData = dict.Where(kvp => !string.IsNullOrEmpty(kvp.Value))
                                                .ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                        }

                        @if (ViewBag.PageNumber > 1)
                        {
                            routeData["pageNumber"] = (ViewBag.PageNumber - 1).ToString();
                            <li class="page-item">
                                <a class="page-link rounded bg-custom text-main border-custom hover-accent" style="padding: 0.5rem 1rem; transition: 0.3s;" href="@Url.Action("Index", routeData)">
                                    &laquo; Əvvəlki
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == 1 || i == ViewBag.TotalPages || (i >= ViewBag.PageNumber - 2 && i <= ViewBag.PageNumber + 2))
                            {
                                routeData["pageNumber"] = i.ToString();
                                if (i == ViewBag.PageNumber)
                                {
                                    <li class="page-item active">
                                        <span class="page-link rounded" style="background-color: var(--accent); color: var(--bg-dark); border-color: var(--accent); padding: 0.5rem 1rem; font-weight: bold;">@i</span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link rounded bg-custom text-main border-custom hover-accent" style="padding: 0.5rem 1rem; transition: 0.3s;" href="@Url.Action("Index", routeData)">@i</a>
                                    </li>
                                }
                            }
                            else if (i == ViewBag.PageNumber - 3 || i == ViewBag.PageNumber + 3)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link rounded bg-custom text-muted border-custom" style="padding: 0.5rem 1rem;">...</span>
                                </li>
                            }
                        }

                        @if (ViewBag.PageNumber < ViewBag.TotalPages)
                        {
                            routeData["pageNumber"] = (ViewBag.PageNumber + 1).ToString();
                            <li class="page-item">
                                <a class="page-link rounded bg-custom text-main border-custom hover-accent" style="padding: 0.5rem 1rem; transition: 0.3s;" href="@Url.Action("Index", routeData)">
                                    Sonrakı &raquo;
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
        }
        else
        {
            <div class="text-center py-5" style="width: 100%; margin: 2rem 0; border: 1px dashed rgba(255,255,255,0.1); border-radius: 10px;">
                <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                <h3 class="mt-3 text-main">Nəticə tapılmadı</h3>
                <p class="text-muted">Fərqli açar sözlər və ya Filtrlər istifadə edərək yenidən yoxlayın.</p>
                <a href="/" class="btn btn-outline-light mt-2" style="border-color: var(--accent); color: var(--accent);">Bütün elanlara bax</a>
            </div>
        }
<!-- Offcanvas Filter -->
<div class="offcanvas offcanvas-start bg-custom text-main" tabindex="-1" id="filterOffcanvas" aria-labelledby="filterOffcanvasLabel">
  <div class="offcanvas-header border-bottom border-custom">
    <h5 class="offcanvas-title" id="filterOffcanvasLabel"><i class="bi bi-funnel text-accent"></i> Filtrlər</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Bağla"></button>
  </div>
  <div class="offcanvas-body">
    <form action="/" method="get">
        <input type="hidden" name="searchString" value="@ViewData["CurrentFilter"]" />
        
        <div class="mb-4">
            <label class="form-label fw-bold">Kateqoriya</label>
            <select name="categoryId" id="offcanvas-categoryId" class="form-select bg-custom text-main border-custom">
                <option value="">Bütün kateqoriyalar</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<EHisseler.Web.Models.Category>)ViewBag.Categories)
                    {
                        if (ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Brend</label>
            <select name="brandId" id="offcanvas-brandId" class="form-select bg-custom text-main border-custom">
                <option value="">Bütün brendlər</option>
                @if (ViewBag.Brands != null)
                {
                    foreach (var brand in (IEnumerable<EHisseler.Web.Models.DeviceBrand>)ViewBag.Brands)
                    {
                        if (ViewData["CurrentBrand"]?.ToString() == brand.Id.ToString())
                        {
                            <option value="@brand.Id" selected>@brand.Name</option>
                        }
                        else
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">vəziyyəti</label>
            <select name="qualityTypeId" class="form-select bg-custom text-main border-custom">
                <option value="">İstənilən vəziyyət</option>
                @if (ViewBag.QualityTypes != null)
                {
                    foreach (var qt in (IEnumerable<EHisseler.Web.Models.QualityType>)ViewBag.QualityTypes)
                    {
                        if (ViewData["CurrentQuality"]?.ToString() == qt.Id.ToString())
                        {
                            <option value="@qt.Id" selected>@qt.Name</option>
                        }
                        else
                        {
                            <option value="@qt.Id">@qt.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Qiymət aralığı (AZN)</label>
            <div class="d-flex gap-2">
                <input type="number" name="minPrice" class="form-control bg-custom text-main border-custom" placeholder="Min" value="@ViewData["MinPrice"]" />
                <span class="align-self-center">-</span>
                <input type="number" name="maxPrice" class="form-control bg-custom text-main border-custom" placeholder="Max" value="@ViewData["MaxPrice"]" />
            </div>
        </div>

        <div class="form-check form-switch mb-4">
            <input class="form-check-input bg-accent border-accent" type="checkbox" name="inStockOnly" id="inStockOnly" value="true" @(Convert.ToBoolean(ViewData["InStockOnly"] ?? false) ? "checked" : "")>
            <label class="form-check-label" for="inStockOnly">Yalnız stokda olanlar</label>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary bg-accent border-accent text-dark fw-bold">Filtrləri tətbiq et</button>
            <a href="/" class="btn btn-outline-secondary text-main">Sıfırla</a>
        </div>
    </form>
  </div>
</div>








<script>
    document.addEventListener("DOMContentLoaded", function() {
        function setupDependentDropdowns(catId, brandId, modelId, partTypeId) {
            const catSelect = document.getElementById(catId);
            const brandSelect = document.getElementById(brandId);
            const modelSelect = document.getElementById(modelId);
            const partSelect = document.getElementById(partTypeId);
            
            if (!catSelect || !brandSelect) return;

            catSelect.addEventListener("change", function() {
                const categoryId = this.value;
                brandSelect.innerHTML = '<option value="">Bütün brendlər</option>';
                if (modelSelect) modelSelect.innerHTML = '<option value="">Bütün modellər</option>';
                if (partSelect) partSelect.innerHTML = '<option value="">Bütün hissələr</option>';
                
                if (categoryId) {
                    fetch('/Ajax/GetBrandsByCategory?categoryId=' + categoryId)
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(item => {
                                brandSelect.innerHTML += '<option value="' + item.id + '">' + item.name + '</option>';
                            });
                        });
                        
                    if (partSelect) {
                        fetch('/Ajax/GetPartTypesByCategory?categoryId=' + categoryId)
                            .then(res => res.json())
                            .then(data => {
                                data.forEach(item => {
                                    partSelect.innerHTML += '<option value="' + item.id + '">' + item.name + '</option>';
                                });
                            });
                    }
                }
            });

            brandSelect.addEventListener("change", function() {
                const categoryId = catSelect.value;
                const brandId = this.value;
                if (modelSelect) modelSelect.innerHTML = '<option value="">Bütün modellər</option>';
                
                if (categoryId && brandId && modelSelect) {
                    fetch('/Ajax/GetModelsByBrand?categoryId=' + categoryId + '&brandId=' + brandId)
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(item => {
                                modelSelect.innerHTML += '<option value="' + item.id + '">' + item.name + '</option>';
                            });
                        });
                }
            });
        }

        setupDependentDropdowns("hero-categoryId", "hero-brandId", "hero-modelId", "hero-partTypeId");
        setupDependentDropdowns("offcanvas-categoryId", "offcanvas-brandId", "offcanvas-modelId", "offcanvas-partTypeId");

        function updateFilterBadge() {
            let count = 0;
            const filterInputs = document.querySelectorAll('.filter-input');
            filterInputs.forEach(input => {
                if (input.type === 'checkbox') {
                    if (input.checked) count++;
                } else {
                    if (input.value && input.value !== "") count++;
                }
            });

            const badge = document.getElementById('detailedFilterBadge');
            if (badge) {
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        // Call on load
        updateFilterBadge();

        // Call on change
        document.querySelectorAll('.filter-input').forEach(input => {
            input.addEventListener('change', updateFilterBadge);
        });

        // Hide main search input when detailed search modal opens, or maybe just clear it so they don't use it
        // The user says: "Zaten detalli axtarışa basdiqda orada detalli inputlar dolduruldugu üçün search inputu itsin ora da nese yazmasinlar"
        const detailedModal = document.getElementById('detailedSearchModal');
        const heroSearchInput = document.getElementById('heroSearchInput');
        if (detailedModal && heroSearchInput) {
            detailedModal.addEventListener('show.bs.modal', function () {
                heroSearchInput.style.display = 'none';
                heroSearchInput.value = ''; // clear it so it doesn't interfere
            });
            detailedModal.addEventListener('hidden.bs.modal', function () {
                heroSearchInput.style.display = ''; // restore to flex
            });
        }
        
        // Reset filters button
        const btnResetFilters = document.getElementById('btnResetFilters');
        if (btnResetFilters) {
            btnResetFilters.addEventListener('click', function() {
                document.querySelectorAll('.filter-input').forEach(input => {
                    if (input.type === 'checkbox') {
                        input.checked = false;
                    } else {
                        input.value = '';
                    }
                });
                updateFilterBadge();
            });
        }
    });
</script>

@model IEnumerable<EHisseler.Web.Models.ActivityLog>
@{
    ViewData["Title"] = "Fəaliyyət Jurnalı";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text me-2 text-primary"></i> Fəaliyyət Jurnalı (Son 100)</h2>
</div>

<div class="card p-4">
    <table class="table table-dark table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th>Tarix</th>
                <th>İstifadəçi ID</th>
                <th>Əməliyyat</th>
                <th>Obyekt</th>
                <th>Obyekt ID</th>
                <th>Detallar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Date.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@log.UserId</td>
                    <td><span class="badge bg-info text-dark">@log.Action</span></td>
                    <td>@log.EntityName</td>
                    <td>@log.EntityId</td>
                    <td class="small">@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@model IEnumerable<EHisseler.Web.Models.SparePart>

@{
    ViewData["Title"] = "Təsdiq Gözləyən Elanlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Təsdiq Gözləyən Elanlar</h2>
        <p class="text-muted mb-0">Satıcılar tərəfindən əlavə edilmiş və yoxlama gözləyən yeni məhsullar</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">İstifadəçilərə qayıt</a>
</div>

<div class="card border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-box-seam display-4 mb-3 d-block text-success opacity-50"></i>
                <h5>Təsdiq gözləyən elan yoxdur</h5>
                <p>Bütün yeni elanlar yoxlanılıb və emal edilib.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Tarix</th>
                            <th>Satıcı</th>
                            <th>Məhsul</th>
                            <th>Model / Növ</th>
                            <th>Qiymət</th>
                            <th>Stok</th>
                            <th class="text-end pe-4">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var ad in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@ad.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-medium">@ad.Seller.CompanyName</td>
                                <td>
                                    <div class="fw-bold text-main text-truncate" style="max-width: 200px;" title="@ad.Title">@ad.Title</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 200px;">@ad.Description</small>
                                </td>
                                <td>
                                    <span class="d-block text-muted small">@ad.DeviceModel.Brand.Name @ad.DeviceModel.Name</span>
                                    <span class="badge bg-secondary bg-opacity-25 text-main border border-custom mt-1">@ad.PartType.Name</span>
                                </td>
                                <td class="fw-bold text-success">@ad.Price <small>@ad.Currency</small></td>
                                <td>
                                    @if(ad.StockQuantity > 0) {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">@ad.StockQuantity</span>
                                    } else {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">0</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form method="post" class="d-inline" asp-action="ApproveAd">
                                        <input type="hidden" name="adId" value="@ad.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3">Dərc et</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1 px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@ad.Id">Rədd et</button>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal-@ad.Id" tabindex="-1">
                                      <div class="modal-dialog">
                                        <div class="modal-content bg-custom border-custom">
                                          <form method="post" asp-action="RejectAd">
                                              <div class="modal-header border-custom">
                                                <h5 class="modal-title">Elanı Rədd Et</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                              </div>
                                              <div class="modal-body text-start">
                                                <input type="hidden" name="adId" value="@ad.Id" />
                                                <div class="mb-3">
                                                    <label class="form-label text-muted small">Rədd səbəbi (Satıcıya göstəriləcək):</label>
                                                    <textarea name="reason" class="form-control bg-custom text-main border-custom" required rows="3" placeholder="Məsələn: Qiymət bazara uyğun deyil və ya şəkillər keyfiyyətsizdir."></textarea>
                                                </div>
                                              </div>
                                              <div class="modal-footer border-custom">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Bağla</button>
                                                <button type="submit" class="btn btn-danger px-4">Təsdiqlə</button>
                                              </div>
                                          </form>
                                        </div>
                                      </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


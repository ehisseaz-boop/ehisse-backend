@{
    ViewData["Title"] = "Müraciətlər";
    Layout = "_Layout";
    var pendingUsers = ViewBag.PendingUsers as List<EHisseler.Web.Models.User>;
    var pendingAds = ViewBag.PendingAds as List<EHisseler.Web.Models.SparePart>;
}

<div class="container" style="margin-top: 2rem;">
    <h2>Müraciətlər</h2>
    
    <!-- Tabs -->
    <ul class="nav nav-tabs" id="myTab" role="tablist" style="margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); display:flex; gap:1rem; list-style:none; padding:0;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab" aria-controls="users" aria-selected="true" style="background:transparent; border:none; border-bottom: 2px solid var(--accent); padding: 0.5rem 1rem; color: var(--text-main); font-weight:bold; cursor:pointer;" onclick="switchTab('users')">Qeydiyyat müraciətləri (@(pendingUsers?.Count ?? 0))</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="ads-tab" data-bs-toggle="tab" data-bs-target="#ads" type="button" role="tab" aria-controls="ads" aria-selected="false" style="background:transparent; border:none; padding: 0.5rem 1rem; color: var(--text-muted); cursor:pointer;" onclick="switchTab('ads')">Elan müraciətləri (@(pendingAds?.Count ?? 0))</button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        <!-- Qeydiyyat Müraciətləri -->
        <div class="tab-pane fade show active" id="users" role="tabpanel" aria-labelledby="users-tab">
            @if (pendingUsers != null && pendingUsers.Any())
            {
                <table style="width:100%; border-collapse: collapse; background: var(--bg-surface); border-radius: 8px; overflow:hidden;">
                    <thead style="background: var(--bg-surface-hover);">
                        <tr>
                            <th style="padding:1rem; text-align:left;">Ad Soyad</th>
                            <th style="padding:1rem; text-align:left;">İstifadəçi adı</th>
                            <th style="padding:1rem; text-align:left;">Nömrə</th>
                            <th style="padding:1rem; text-align:left;">Rol</th>
                            <th style="padding:1rem; text-align:left;">Tarix</th>
                            <th style="padding:1rem; text-align:left;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in pendingUsers)
                        {
                            <tr style="border-top: 1px solid var(--border-color);">
                                <td style="padding:1rem;">@user.FirstName @user.LastName</td>
                                <td style="padding:1rem;">@user.Username</td>
                                <td style="padding:1rem;">@user.Phone</td>
                                <td style="padding:1rem;">@user.Role</td>
                                <td style="padding:1rem;">@user.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td style="padding:1rem; display:flex; gap:0.5rem;">
                                    <form asp-action="ApproveUser" method="post" style="display:inline;">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="bg-accent" style="border:none; padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer; color: var(--bg-main);">Qəbul et</button>
                                    </form>
                                    <button type="button" style="border:1px solid var(--danger); background:transparent; color:var(--danger); padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer;" onclick="openRejectUserModal(@user.Id)">İmtina et</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>Gözləyən qeydiyyat müraciəti yoxdur.</p>
            }
        </div>

        <!-- Elan Müraciətləri -->
        <div class="tab-pane fade" id="ads" role="tabpanel" aria-labelledby="ads-tab" style="display:none;">
            
            <div style="margin-bottom: 1rem;">
                <button id="btn-new-ads" style="background:var(--accent); color:var(--bg-main); border:none; padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer;" onclick="switchAdSubTab('new')">Yeni</button>
                <button id="btn-ren-ads" style="background:var(--bg-surface); color:var(--text-main); border:1px solid var(--border-color); padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer;" onclick="switchAdSubTab('renewal')">Yenilənmə</button>
            </div>

            <div id="new-ads">
                @if (pendingAds != null)
                {
                    var newAds = pendingAds.Where(a => a.Reviews == null || !a.Reviews.Any()).ToList();
                    if (newAds.Any())
                    {
                        <table style="width:100%; border-collapse: collapse; background: var(--bg-surface); border-radius: 8px; overflow:hidden;">
                            <thead style="background: var(--bg-surface-hover);">
                                <tr>
                                    <th style="padding:1rem; text-align:left;">Elan Adı</th>
                                    <th style="padding:1rem; text-align:left;">Satıcı</th>
                                    <th style="padding:1rem; text-align:left;">Qiymət</th>
                                    <th style="padding:1rem; text-align:left;">Əməliyyatlar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ad in newAds)
                                {
                                    <tr style="border-top: 1px solid var(--border-color);">
                                        <td style="padding:1rem;"><a href="/Warehouse/Details/@ad.Id" target="_blank" style="color:var(--accent);">@ad.Title</a></td>
                                        <td style="padding:1rem;">@ad.Seller?.CompanyName</td>
                                        <td style="padding:1rem;">@ad.Price AZN</td>
                                        <td style="padding:1rem; display:flex; gap:0.5rem;">
                                            <form asp-action="ApproveAd" method="post" style="display:inline;">
                                                <input type="hidden" name="adId" value="@ad.Id" />
                                                <button type="submit" class="bg-accent" style="border:none; padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer; color: var(--bg-main);">Qəbul et</button>
                                            </form>
                                            <button type="button" style="border:1px solid var(--danger); background:transparent; color:var(--danger); padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer;" onclick="openRejectAdModal(@ad.Id)">İmtina et</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>Yeni elan müraciəti yoxdur.</p>
                    }
                }
            </div>

            <div id="renewal-ads" style="display:none;">
                @if (pendingAds != null)
                {
                    var renAds = pendingAds.Where(a => a.Reviews != null && a.Reviews.Any()).ToList();
                    if (renAds.Any())
                    {
                        <table style="width:100%; border-collapse: collapse; background: var(--bg-surface); border-radius: 8px; overflow:hidden;">
                            <thead style="background: var(--bg-surface-hover);">
                                <tr>
                                    <th style="padding:1rem; text-align:left;">Elan Adı</th>
                                    <th style="padding:1rem; text-align:left;">Satıcı</th>
                                    <th style="padding:1rem; text-align:left;">Qiymət</th>
                                    <th style="padding:1rem; text-align:left;">Əməliyyatlar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ad in renAds)
                                {
                                    <tr style="border-top: 1px solid var(--border-color);">
                                        <td style="padding:1rem;"><a href="/Warehouse/Details/@ad.Id" target="_blank" style="color:var(--accent);">@ad.Title</a></td>
                                        <td style="padding:1rem;">@ad.Seller?.CompanyName</td>
                                        <td style="padding:1rem;">@ad.Price AZN</td>
                                        <td style="padding:1rem; display:flex; gap:0.5rem;">
                                            <form asp-action="ApproveAd" method="post" style="display:inline;">
                                                <input type="hidden" name="adId" value="@ad.Id" />
                                                <button type="submit" class="bg-accent" style="border:none; padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer; color: var(--bg-main);">Qəbul et</button>
                                            </form>
                                            <button type="button" style="border:1px solid var(--danger); background:transparent; color:var(--danger); padding:0.5rem 1rem; border-radius:4px; font-weight:bold; cursor:pointer;" onclick="openRejectAdModal(@ad.Id)">İmtina et</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>Yenilənmə elan müraciəti yoxdur.</p>
                    }
                }
            </div>

        </div>
    </div>
</div>

<!-- Reject User Modal -->
<div id="rejectUserModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999; justify-content:center; align-items:center;">
    <div style="background-color: var(--bg-surface); padding: 2rem; border-radius: 12px; max-width: 400px; width:100%;">
        <h3 style="margin-top:0; color:var(--text-main);">Qeydiyyatdan İmtina</h3>
        <p style="color:var(--text-muted); font-size:0.9rem;">İmtina səbəbini qeyd edin. (Səbəb email-ə göndəriləcək)</p>
        <form asp-action="RejectUser" method="post" id="rejectUserForm">
            <input type="hidden" name="userId" id="rejectUserId" />
            <textarea name="reason" id="rejectUserReason" required rows="3" style="width:100%; padding: 0.5rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-main); outline: none; margin-bottom:1rem; box-sizing:border-box;" placeholder="Səbəb..."></textarea>
            <div style="text-align:right;">
                <button type="button" onclick="closeRejectUserModal()" style="padding: 0.5rem 1rem; border: 1px solid var(--border-color); background:transparent; color:var(--text-main); border-radius: 8px; font-weight: 600; cursor: pointer;">Ləğv et</button>
                <button type="submit" style="padding: 0.5rem 1rem; border: none; background:var(--danger); color:white; border-radius: 8px; font-weight: 600; cursor: pointer; margin-left:0.5rem;">İmtina et</button>
            </div>
        </form>
    </div>
</div>

<!-- Reject Ad Modal -->
<div id="rejectAdModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999; justify-content:center; align-items:center;">
    <div style="background-color: var(--bg-surface); padding: 2rem; border-radius: 12px; max-width: 400px; width:100%;">
        <h3 style="margin-top:0; color:var(--text-main);">Elandan İmtina</h3>
        <p style="color:var(--text-muted); font-size:0.9rem;">İmtina səbəbini qeyd edin. (Səbəb email-ə göndəriləcək)</p>
        <form asp-action="RejectAd" method="post" id="rejectAdForm">
            <input type="hidden" name="adId" id="rejectAdId" />
            <textarea name="reason" id="rejectAdReason" required rows="3" style="width:100%; padding: 0.5rem; background-color: var(--bg-main); border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-main); outline: none; margin-bottom:1rem; box-sizing:border-box;" placeholder="Səbəb..."></textarea>
            <div style="text-align:right;">
                <button type="button" onclick="closeRejectAdModal()" style="padding: 0.5rem 1rem; border: 1px solid var(--border-color); background:transparent; color:var(--text-main); border-radius: 8px; font-weight: 600; cursor: pointer;">Ləğv et</button>
                <button type="submit" style="padding: 0.5rem 1rem; border: none; background:var(--danger); color:white; border-radius: 8px; font-weight: 600; cursor: pointer; margin-left:0.5rem;">İmtina et</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            if(tab === "users") {
                document.getElementById("users").style.display = "block";
                document.getElementById("ads").style.display = "none";
                document.getElementById("users-tab").style.borderBottom = "2px solid var(--accent)";
                document.getElementById("users-tab").style.color = "var(--text-main)";
                document.getElementById("ads-tab").style.borderBottom = "none";
                document.getElementById("ads-tab").style.color = "var(--text-muted)";
            } else {
                document.getElementById("users").style.display = "none";
                document.getElementById("ads").style.display = "block";
                document.getElementById("ads-tab").style.borderBottom = "2px solid var(--accent)";
                document.getElementById("ads-tab").style.color = "var(--text-main)";
                document.getElementById("users-tab").style.borderBottom = "none";
                document.getElementById("users-tab").style.color = "var(--text-muted)";
            }
        }

        function switchAdSubTab(subTab) {
            if(subTab === "new") {
                document.getElementById("new-ads").style.display = "block";
                document.getElementById("renewal-ads").style.display = "none";
                document.getElementById("btn-new-ads").style.background = "var(--accent)";
                document.getElementById("btn-new-ads").style.color = "var(--bg-main)";
                document.getElementById("btn-new-ads").style.border = "none";
                document.getElementById("btn-ren-ads").style.background = "var(--bg-surface)";
                document.getElementById("btn-ren-ads").style.color = "var(--text-main)";
                document.getElementById("btn-ren-ads").style.border = "1px solid var(--border-color)";
            } else {
                document.getElementById("new-ads").style.display = "none";
                document.getElementById("renewal-ads").style.display = "block";
                document.getElementById("btn-ren-ads").style.background = "var(--accent)";
                document.getElementById("btn-ren-ads").style.color = "var(--bg-main)";
                document.getElementById("btn-ren-ads").style.border = "none";
                document.getElementById("btn-new-ads").style.background = "var(--bg-surface)";
                document.getElementById("btn-new-ads").style.color = "var(--text-main)";
                document.getElementById("btn-new-ads").style.border = "1px solid var(--border-color)";
            }
        }

        function openRejectUserModal(userId) {
            document.getElementById("rejectUserId").value = userId;
            document.getElementById("rejectUserModal").style.display = "flex";
        }
        function closeRejectUserModal() {
            document.getElementById("rejectUserModal").style.display = "none";
            document.getElementById("rejectUserId").value = "";
            document.getElementById("rejectUserReason").value = "";
        }
        
        function openRejectAdModal(adId) {
            document.getElementById("rejectAdId").value = adId;
            document.getElementById("rejectAdModal").style.display = "flex";
        }
        function closeRejectAdModal() {
            document.getElementById("rejectAdModal").style.display = "none";
            document.getElementById("rejectAdId").value = "";
            document.getElementById("rejectAdReason").value = "";
        }
    </script>
}

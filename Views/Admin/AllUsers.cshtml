@model IEnumerable<EHisseler.Web.Models.User>
@{
    ViewData["Title"] = "Bütün İstifadəçilər";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2 text-primary"></i> Bütün İstifadəçilər</h2>
</div>

<div class="card p-4">
    <table class="table table-dark table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ad / Soyad</th>
                <th>İstifadəçi Adı</th>
                <th>Rol</th>
                <th>Status</th>
                <th>Qeydiyyat Tarixi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName @user.LastName</td>
                    <td>@user.Username</td>
                    <td><span class="badge bg-info text-dark">@user.Role</span></td>
                    <td>
                        @if (user.ApprovalStatus == EHisseler.Web.Models.ApprovalStatus.Approved)
                        {
                            <span class="badge bg-success">Təsdiqlənib</span>
                        }
                        else if (user.ApprovalStatus == EHisseler.Web.Models.ApprovalStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Gözləyir</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rədd edilib</span>
                        }
                    </td>
                    <td>@user.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@model IEnumerable<EHisseler.Web.Models.SparePart>
@{
    ViewData["Title"] = "B?t?n Elanlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-collection me-2 text-primary"></i> B?t?n Elanlar</h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<div class="card p-4">
    <table class="table table-dark table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ba?l?q</th>
                <th>Sat?c?</th>
                <th>Cihaz</th>
                <th>Qiym?t</th>
                <th>Status</th>
                <th>Tarix</th>
                <th>?m?liyyat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ad in Model)
            {
                                <tr>
                    <td>@ad.Id</td>
                    <td>@ad.Title</td>
                    <td>@ad.Seller?.CompanyName</td>
                    <td>@ad.DeviceModel?.Brand?.Name @ad.DeviceModel?.Name</td>
                    <td class="fw-bold text-success">@ad.Price @ad.Currency</td>
                    <td><span class="badge bg-secondary">@(ad.IsDeleted ? "Silinib" : ad.ModerationStatus.ToString())</span></td>
                    <td>@ad.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (ad.ModerationStatus == EHisseler.Web.Models.ApprovalStatus.Approved || ad.IsDeleted || ad.ModerationStatus == EHisseler.Web.Models.ApprovalStatus.Rejected)
                        {
                            <form asp-action="RestoreAd" method="post" class="d-inline">
                                <input type="hidden" name="adId" value="@ad.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" onclick="return confirm('Bu elan? b?rpa etm?k ist?diyiniz? ?minsiniz? Stok m?sb?t olmal?d?r.');">B?rpa et</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



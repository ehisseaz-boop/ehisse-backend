@model IEnumerable<EHisseler.Web.Models.Category>
@{
    ViewData["Title"] = "Kateqoriyalar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags me-2 text-primary"></i> Kateqoriyalar</h2>
    <button class="btn btn-primary"><i class="bi bi-plus"></i> Yeni Kateqoriya</button>
</div>

<div class="card p-4">
    <table class="table table-dark table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ad</th>
                <th>Sıra</th>
                <th>Status</th>
                <th>Əməliyyat</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td class="fw-bold">@cat.Name</td>
                    <td>@cat.DisplayOrder</td>
                    <td>
                        @if(cat.IsActive) { <span class="badge bg-success">Aktiv</span> } else { <span class="badge bg-danger">Deaktiv</span> }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-light"><i class="bi bi-pencil"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@model EHisseler.Web.Models.SparePart

@{
    ViewData["Title"] = "Yeni Elan";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Yeni Ehtiyat Hissəsi</h2>
    <p class="text-muted">Anbara yeni məhsul əlavə edin</p>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <form asp-action="AddPart" method="post">
            <!-- Əsas Məlumatlar -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4 d-flex align-items-center gap-2">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Əsas Məlumatlar</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-medium text-muted small">Başlıq</label>
                        <input asp-for="Title" class="form-control form-control-lg fs-6  border-0" placeholder="Məsələn: iPhone 16 Ekran Orijinal" required />
                    </div>
                    
                    <div class="row mb-4 g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-medium text-muted small">Kateqoriya</label>
                            <select id="categoryId" name="CategoryId" class="form-select  border-0" asp-items="ViewBag.Categories">
                                <option value="">-- Seçin --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium text-muted small">Brend</label>
                            <select id="brandId" name="BrandId" class="form-select  border-0">
                                <option value="">-- Əvvəlcə kateqoriya seçin --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DeviceModelId" class="form-label fw-medium text-muted small">Cihaz Modeli</label>
                            <select asp-for="DeviceModelId" class="form-select  border-0" required>
                                <option value="">-- Əvvəlcə brend seçin --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="PartTypeId" class="form-label fw-medium text-muted small">Detal Növü</label>
                            <select asp-for="PartTypeId" class="form-select  border-0" required>
                                <option value="">-- Əvvəlcə kateqoriya seçin --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QualityTypeId" class="form-label fw-medium text-muted small">Vəziyyəti</label>
                            <select asp-for="QualityTypeId" class="form-select  border-0" asp-items="ViewBag.QualityTypes" required></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Satış Şərtləri -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4 d-flex align-items-center gap-2">
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Satış Şərtləri</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-medium text-muted small">Qiymət (AZN)</label>
                            <div class="input-group">
                                <span class="input-group-text  border-0 text-muted">₼</span>
                                <input asp-for="Price" type="number" step="0.01" class="form-control  border-0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StockQuantity" class="form-label fw-medium text-muted small">Stok Miqdarı</label>
                            <div class="input-group">
                                <span class="input-group-text  border-0 text-muted"><i class="bi bi-boxes"></i></span>
                                <input asp-for="StockQuantity" type="number" class="form-control  border-0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WarrantyMonths" class="form-label fw-medium text-muted small">Zəmanət (Ay)</label>
                            <div class="input-group">
                                <span class="input-group-text  border-0 text-muted"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="WarrantyMonths" type="number" class="form-control  border-0" value="0" required />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Təsvir -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0 px-4 d-flex align-items-center gap-2">
                    <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-card-text"></i>
                    </div>
                    <h5 class="fw-bold mb-0">Əlavə Məlumat</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-2">
                        <label asp-for="Description" class="form-label fw-medium text-muted small">Təsvir</label>
                        <textarea asp-for="Description" class="form-control  border-0" rows="5" placeholder="Məhsul haqqında ətraflı məlumat..." required></textarea>
                    </div>
                </div>
            </div>

            <!-- Göndər -->
            <div class="d-flex justify-content-end gap-3 mb-5">
                <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3 fw-medium">Ləğv Et</a>
                <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-medium shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-check2-circle"></i> Yoxlamaya Göndər
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var initialCategoryId = '@(ViewBag.SelectedCategoryId ?? "")';
        var initialBrandId = '@(ViewBag.SelectedBrandId ?? "")';
        var initialModelId = '@(Model?.DeviceModelId > 0 ? Model.DeviceModelId.ToString() : "")';
        var initialPartTypeId = '@(Model?.PartTypeId > 0 ? Model.PartTypeId.ToString() : "")';

        function fetchBrandsAndPartTypes(catId, selectedBrandId, selectedPartTypeId) {
            var brandSelect = document.getElementById('brandId');
            var partTypeSelect = document.getElementById('PartTypeId');
            var modelSelect = document.getElementById('DeviceModelId');

            if (!catId) {
                brandSelect.innerHTML = '<option value="">-- Əvvəlcə kateqoriya seçin --</option>';
                modelSelect.innerHTML = '<option value="">-- Əvvəlcə brend seçin --</option>';
                partTypeSelect.innerHTML = '<option value="">-- Əvvəlcə kateqoriya seçin --</option>';
                return;
            }

            fetch('/Ajax/GetBrandsByCategory?categoryId=' + catId)
                .then(response => response.json())
                .then(data => {
                    brandSelect.innerHTML = '<option value="">-- Seçin --</option>';
                    data.forEach(item => {
                        brandSelect.add(new Option(item.name, item.id));
                    });
                    
                    if (selectedBrandId) {
                        brandSelect.value = selectedBrandId;
                        fetchModels(catId, selectedBrandId, initialModelId);
                    }
                });

            fetch('/Ajax/GetPartTypesByCategory?categoryId=' + catId)
                .then(response => response.json())
                .then(data => {
                    partTypeSelect.innerHTML = '<option value="">-- Seçin --</option>';
                    data.forEach(item => {
                        partTypeSelect.add(new Option(item.name, item.id));
                    });
                    
                    if (selectedPartTypeId) {
                        partTypeSelect.value = selectedPartTypeId;
                    }
                });
        }

        function fetchModels(catId, brandId, selectedModelId) {
            var modelSelect = document.getElementById('DeviceModelId');
            if (!catId || !brandId) {
                modelSelect.innerHTML = '<option value="">-- Əvvəlcə brend seçin --</option>';
                return;
            }
            
            fetch('/Ajax/GetModelsByBrand?categoryId=' + catId + '&brandId=' + brandId)
                .then(response => response.json())
                .then(data => {
                    modelSelect.innerHTML = '<option value="">-- Seçin --</option>';
                    data.forEach(item => {
                        modelSelect.add(new Option(item.name, item.id));
                    });
                    
                    if (selectedModelId) {
                        modelSelect.value = selectedModelId;
                    }
                });
        }

        document.getElementById('categoryId').addEventListener('change', function () {
            var catId = this.value;
            var brandSelect = document.getElementById('brandId');
            var modelSelect = document.getElementById('DeviceModelId');
            var partTypeSelect = document.getElementById('PartTypeId');

            brandSelect.innerHTML = '<option value="">-- Əvvəlcə kateqoriya seçin --</option>';
            modelSelect.innerHTML = '<option value="">-- Əvvəlcə brend seçin --</option>';
            partTypeSelect.innerHTML = '<option value="">-- Əvvəlcə kateqoriya seçin --</option>';

            if (catId) {
                fetchBrandsAndPartTypes(catId, null, null);
            }
        });

        document.getElementById('brandId').addEventListener('change', function () {
            var catId = document.getElementById('categoryId').value;
            var brandId = this.value;
            var modelSelect = document.getElementById('DeviceModelId');

            modelSelect.innerHTML = '<option value="">-- Əvvəlcə brend seçin --</option>';

            if (brandId) {
                fetchModels(catId, brandId, null);
            }
        });
        
        // Initialize if pre-selected
        var currentCat = document.getElementById('categoryId').value;
        if (currentCat) {
            fetchBrandsAndPartTypes(currentCat, initialBrandId, initialPartTypeId);
        }
    </script>
}


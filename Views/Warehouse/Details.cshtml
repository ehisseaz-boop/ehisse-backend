@model EHisseler.Web.Models.SparePart

@{
    ViewData["Title"] = Model.Title;
    var mainImage = Model.Images?.FirstOrDefault(i => i.IsMain) ?? Model.Images?.FirstOrDefault();
    var otherImages = Model.Images?.Where(i => i.Id != mainImage?.Id).ToList();
    

}

<div class="container my-5">
    <div class="mb-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left"></i> Geri qay?t</a>
    </div>

    <div class="row g-5">
        <!-- Sol T?r?f - ??kill?r -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                @if (mainImage != null)
                {
                    <img src="@mainImage.ImageUrl" class="img-fluid w-100" style="max-height: 500px; object-fit: contain; background: #fff;" alt="@Model.Title" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 400px;">
                        <i class="bi bi-image text-muted" style="font-size: 5rem;"></i>
                    </div>
                }
            </div>
            
            @if (otherImages != null && otherImages.Any())
            {
                <div class="d-flex gap-2 overflow-auto hide-scrollbar">
                    @foreach (var img in otherImages)
                    {
                        <div class="rounded-3 border overflow-hidden" style="width: 80px; height: 80px; flex-shrink: 0;">
                            <img src="@img.ImageUrl" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Dig?r ??kil">
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Sa? T?r?f - M?lumat v? Sat?c? -->
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-secondary bg-opacity-10 text-muted rounded-pill px-3 py-2 border border-secondary border-opacity-25">
                    @Model.DeviceModel.Brand.Name @Model.DeviceModel.Name
                </span>
                <span class="text-muted small"><i class="bi bi-eye"></i> @Model.ViewCount bax??</span>
            </div>
            
            <h1 class="fw-bold mb-3">@Model.Title</h1>
            
            <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                <h2 class="text-accent fw-bold mb-0">@Math.Floor(Model.Price) <small class="fs-5">@Model.Currency</small></h2>
                <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill">
                    <i class="bi bi-check-circle-fill"></i> Stokda @Model.StockQuantity ?d?d
                </span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="text-muted small mb-1">Kateqoriya</div>
                    <div class="fw-medium">@Model.DeviceModel.Category.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">N?v</div>
                    <div class="fw-medium">@Model.PartType.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">Keyfiyy?t</div>
                    <div class="fw-medium">@Model.QualityType.Name</div>
                </div>
                <div class="col-6">
                    <div class="text-muted small mb-1">Z?man?t</div>
                    <div class="fw-medium">@(Model.WarrantyMonths > 0 ? $"{Model.WarrantyMonths} ay" : "Yoxdur")</div>
                </div>
            </div>

            <h5 class="fw-bold mb-3">M?hsul haqq?nda</h5>
            <p class="text-muted mb-4" style="line-height: 1.6;">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "M?hsul bar?d? ?lav? m?lumat qeyd edilm?yib." : Model.Description)
            </p>

            <!-- ?dar?etm? Paneli -->
            <div class="card border-0 bg-light text-dark rounded-4 p-4 mt-5">
                <h5 class="fw-bold mb-4">Elan ?dar?etm?si</h5>
                
                <div class="d-grid gap-2">
                    <a href="@Url.Action("EditPart", "Warehouse", new { id = Model.Id })" class="btn btn-warning rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-pencil fs-5"></i> Redakt? et
                    </a>
                    
                    @if(Model.StockQuantity > 0)
                    {
                        <form asp-action="RecordSale" asp-controller="Warehouse" method="post" class="d-grid gap-2 m-0 p-0" onsubmit="return confirm('@(Model.StockQuantity == 1 ? "Bu elan ?zr? son m?hsul sat?ld?. Sat??? t?sdiql?yirsinizmi?" : "Bir ?d?d sat?ld??? kimi qeyd? al?nacaq v? elan?n stok say? bir vahid azalacaq. T?sdiq edirsinizmi?")');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <button type="submit" class="btn btn-success rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-cart-check fs-5"></i> @(Model.StockQuantity == 1 ? "Sat?ld?" : "Bu elandan bir m?hsul daha sat?ld?")
                            </button>
                        </form>
                    }
                    
                    @if(Model.ModerationStatus != EHisseler.Web.Models.ApprovalStatus.Approved)
                    {
                        <form asp-action="DeactivatePart" asp-controller="Warehouse" method="post" class="d-grid gap-2 m-0 p-0" onsubmit="return confirm('Bu elan? deaktiv etm?k ist?diyiniz? ?minsinizmi?');">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger rounded-pill fw-bold py-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-x-circle fs-5"></i> Deaktiv et
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- X?rit? -->
    <div class="mt-5 pt-5 border-top">
        <h4 class="fw-bold mb-4"><i class="bi bi-geo-alt-fill text-danger"></i> Ma?azan?n ?nvan?</h4>
        @if (!string.IsNullOrWhiteSpace(Model.Seller.Address))
        {
            <p class="mb-3">@Model.Seller.Address</p>
            <div class="rounded-4 overflow-hidden border shadow-sm">
                <iframe 
                    width="100%" 
                    height="400" 
                    frameborder="0" 
                    scrolling="no" 
                    marginheight="0" 
                    marginwidth="0" 
                    src="https://maps.google.com/maps?q=@(Uri.EscapeDataString(Model.Seller.Address))&t=&z=15&ie=UTF8&iwloc=&output=embed">
                </iframe>
            </div>
        }
        else
        {
            <div class="alert alert-secondary border-0 rounded-4 text-center p-4">
                <i class="bi bi-info-circle fs-3 text-muted mb-2 d-block"></i>
                Satıcı dəqiq ünvan qeyd etməyib. Ətraflı məlumat üçün əlaqə saxlayın.
            </div>
        }
    </div>
</div>

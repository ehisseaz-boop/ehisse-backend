@model EHisseler.Web.Models.SellerProfile

@{
    ViewData["Title"] = "Tənzimləmələr";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">Hesab Tənzimləmələri</h2>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="card shadow-sm border-0 rounded-4 p-4">
                <form asp-action="Settings" method="post">
                    
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-bold">Mobil Nömrə</label>
                        <input asp-for="Phone" class="form-control" placeholder="Məs: 0501234567" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                        
                        @if (Model.IsPhoneVerified)
                        {
                            <div class="text-success small mt-1"><i class="bi bi-check-circle-fill"></i> Nömrə təsdiqlənib</div>
                        }
                        else
                        {
                            <div class="text-danger small mt-1"><i class="bi bi-x-circle-fill"></i> Nömrə təsdiqlənməyib</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="WhatsAppNumber" class="form-label fw-bold">WhatsApp Nömrəsi</label>
                        <input asp-for="WhatsAppNumber" class="form-control" placeholder="Məs: 0501234567 (Əgər fərqlidirsə)" />
                        <div class="form-text">Boş buraxıldıqda əsas mobil nömrəniz istifadə ediləcək.</div>
                        <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="ShowContactInfoInAds" class="form-check-input" type="checkbox">
                        <label asp-for="ShowContactInfoInAds" class="form-check-label fw-bold">
                            Əlaqə məlumatlarım elanlarımda göstərilsin
                        </label>
                        <div class="form-text">Bu seçimi ləğv etsəniz, elanlarınızda zəng və WhatsApp düymələri gizlədiləcək.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index", "Warehouse")" class="btn btn-outline-secondary rounded-pill px-4">Ləğv et</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Yadda saxla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
